<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="514.0" prefWidth="574.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javaapp.Controller">
   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="txtName" promptText="Name" />
            <ChoiceBox fx:id="cbYear" prefHeight="26.0" prefWidth="590.0" />
            <TextField fx:id="txtCourse" prefHeight="27.0" prefWidth="302.0" promptText="Course" />
            <HBox alignment="CENTER" prefHeight="35.0" prefWidth="302.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addStudent" style="-fx-background-color: B3BFFF;" text="Add">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin></Button>
                  <Button mnemonicParsing="false" onAction="#updateStudent" style="-fx-background-color: B3BFFF;" text="Update">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin></Button>
                  <Button fx:id="deleteStudent" mnemonicParsing="false" onAction="#deleteStudent" style="-fx-background-color: B3BFFF;" text="Delete">
