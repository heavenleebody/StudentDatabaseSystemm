                  <Button fx:id="clearFields" mnemonicParsing="false" onAction="#clearFields" style="-fx-background-color: B3BFFF;" text="Clear" />
               </children>
            </HBox>
            <TableView fx:id="table" prefHeight="400.0" prefWidth="553.0">
